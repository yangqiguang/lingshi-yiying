# 复制本文件为 .env 后按需填写；.env 已被 .gitignore 排除，切勿提交真实值。
# 未配置的项一律使用代码内默认值，不影响本地启动。

# 阿里云百炼 API Key。留空时 AI 助手自动降级为「本地模板回答」，
# 界面会标注 source=local，不会编造检查值、日期或剂量。
# 读取顺序：环境变量 DASHSCOPE_API_KEY -> web/server/.dashscope_key（该文件不入库）
DASHSCOPE_API_KEY=

# 服务端口：5000 为统一后端主端口，5001 为兼容旧 App 的附加监听。
LSY_PORT=5000
LSY_LEGACY_PORT=5001

# 检测模型与推理阈值。默认读取 web/server/models/best.onnx，
# 一般情况下无需设置 DETECT_MODEL；自定义时建议填绝对路径。
# DETECT_MODEL=/absolute/path/to/best.onnx
DETECT_CONF=0.15
DETECT_IOU=0.45
DETECT_IMG_SIZE=640
DETECT_MAX_BOXES=20

# App 端后端地址：不通过环境变量读取，两个配置文件默认指向本地 127.0.0.1:5000，
# 部署时按需修改 app/h5/config.js 与 app/hybrid/html/config.js。
